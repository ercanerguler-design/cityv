# DATABASE_URL=postgresql+psycopg://cityv_user:cityv_secret@localhost:5432/cityv
# DATABASE_FALLBACK_URL=sqlite:///./cityv_v2.db
# DB_FALLBACK_ENABLED=true
ACCESS_TOKEN_EXPIRE_MINUTES=720
